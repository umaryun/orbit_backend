# ─── Supabase Postgres ───
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# ─── WhatsApp Cloud API ───
WHATSAPP_TOKEN=EAAxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=my-custom-verify-token

# ─── Gemini (LLM + Embeddings — free tier via aistudio.google.com) ───
GEMINI_API_KEY=AIzaXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_LLM_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ─── Groq (Whisper — free tier) ───
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── App ───
LOG_LEVEL=INFO
ENVIRONMENT=development
